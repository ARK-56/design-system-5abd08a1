{
  "name": "ark-56-design-system",
  "private": true,
  "version": "0.1.0",
  "description": "White-label design system: shared tokens + React component library for client projects",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "pnpm --filter @ark-56/ui storybook",
    "build-storybook": "pnpm --filter @ark-56/ui build-storybook",
    "tokens:build": "pnpm --filter @ark-56/tokens build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "axe-core": "^4.13.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  }
}
